{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requestid"
    },
    "code": {
      "title": "Code",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    },
    "details": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Details",
      "type": "array"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "ApiError",
  "type": "object"
}

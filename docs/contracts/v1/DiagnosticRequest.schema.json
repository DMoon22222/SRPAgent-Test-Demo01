{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CaseFeedback": {
      "additionalProperties": false,
      "properties": {
        "caseId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Caseid",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCESS",
            "COMPILE_ERROR",
            "RUNTIME_ERROR",
            "WRONG_ANSWER",
            "TIME_LIMIT_EXCEEDED",
            "ENVIRONMENT_ERROR",
            "SANDBOX_ERROR",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "failedStage": {
          "enum": [
            "NONE",
            "PRE_CHECK",
            "COMPILE",
            "RUNTIME",
            "TEST",
            "SANDBOX",
            "UNKNOWN"
          ],
          "title": "Failedstage",
          "type": "string"
        },
        "exitCode": {
          "title": "Exitcode",
          "type": "integer"
        },
        "stdout": {
          "default": "",
          "maxLength": 12000,
          "title": "Stdout",
          "type": "string"
        },
        "stderr": {
          "default": "",
          "maxLength": 12000,
          "title": "Stderr",
          "type": "string"
        },
        "errorLog": {
          "default": "",
          "maxLength": 12000,
          "title": "Errorlog",
          "type": "string"
        },
        "stdoutTruncated": {
          "default": false,
          "title": "Stdouttruncated",
          "type": "boolean"
        },
        "stderrTruncated": {
          "default": false,
          "title": "Stderrtruncated",
          "type": "boolean"
        },
        "errorLogTruncated": {
          "default": false,
          "title": "Errorlogtruncated",
          "type": "boolean"
        },
        "expectedOutput": {
          "default": "",
          "maxLength": 12000,
          "title": "Expectedoutput",
          "type": "string"
        },
        "executionTimeMs": {
          "default": 0,
          "minimum": 0,
          "title": "Executiontimems",
          "type": "integer"
        }
      },
      "required": [
        "caseId",
        "status",
        "failedStage",
        "exitCode"
      ],
      "title": "CaseFeedback",
      "type": "object"
    },
    "CodeArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Artifactid",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Revision",
          "type": "string"
        },
        "kind": {
          "const": "snippet",
          "default": "snippet",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "enum": [
            "python",
            "java"
          ],
          "title": "Language",
          "type": "string"
        },
        "entryPoint": {
          "enum": [
            "Main.py",
            "Main.java"
          ],
          "title": "Entrypoint",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/SourceFile"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "artifactId",
        "revision",
        "language",
        "entryPoint",
        "files"
      ],
      "title": "CodeArtifact",
      "type": "object"
    },
    "ExecutionFeedback": {
      "additionalProperties": false,
      "properties": {
        "runId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Runid",
          "type": "string"
        },
        "source": {
          "enum": [
            "B_SANDBOX",
            "EXTERNAL"
          ],
          "title": "Source",
          "type": "string"
        },
        "codeArtifactId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Codeartifactid",
          "type": "string"
        },
        "codeRevision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Coderevision",
          "type": "string"
        },
        "codeDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codedigest"
        },
        "testSuiteId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Testsuiteid"
        },
        "testRevision": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Testrevision"
        },
        "testDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Testdigest"
        },
        "status": {
          "enum": [
            "SUCCESS",
            "COMPILE_ERROR",
            "RUNTIME_ERROR",
            "WRONG_ANSWER",
            "TIME_LIMIT_EXCEEDED",
            "ENVIRONMENT_ERROR",
            "SANDBOX_ERROR",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "failedStage": {
          "enum": [
            "NONE",
            "PRE_CHECK",
            "COMPILE",
            "RUNTIME",
            "TEST",
            "SANDBOX",
            "UNKNOWN"
          ],
          "title": "Failedstage",
          "type": "string"
        },
        "exitCode": {
          "title": "Exitcode",
          "type": "integer"
        },
        "validationScope": {
          "default": "UNKNOWN",
          "enum": [
            "STDIO",
            "SYNTAX_ONLY",
            "UNKNOWN"
          ],
          "title": "Validationscope",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/TestSummary"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/CaseFeedback"
          },
          "maxItems": 20,
          "title": "Failures",
          "type": "array"
        },
        "stdout": {
          "default": "",
          "maxLength": 12000,
          "title": "Stdout",
          "type": "string"
        },
        "stderr": {
          "default": "",
          "maxLength": 12000,
          "title": "Stderr",
          "type": "string"
        },
        "errorLog": {
          "default": "",
          "maxLength": 12000,
          "title": "Errorlog",
          "type": "string"
        },
        "stdoutTruncated": {
          "default": false,
          "title": "Stdouttruncated",
          "type": "boolean"
        },
        "stderrTruncated": {
          "default": false,
          "title": "Stderrtruncated",
          "type": "boolean"
        },
        "errorLogTruncated": {
          "default": false,
          "title": "Errorlogtruncated",
          "type": "boolean"
        }
      },
      "required": [
        "runId",
        "source",
        "codeArtifactId",
        "codeRevision",
        "status",
        "failedStage",
        "exitCode"
      ],
      "title": "ExecutionFeedback",
      "type": "object"
    },
    "ProblemSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 12000,
          "title": "Description",
          "type": "string"
        },
        "constraints": {
          "items": {
            "maxLength": 12000,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Constraints",
          "type": "array"
        },
        "acceptanceCriteria": {
          "items": {
            "maxLength": 12000,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Acceptancecriteria",
          "type": "array"
        }
      },
      "required": [
        "description"
      ],
      "title": "ProblemSpec",
      "type": "object"
    },
    "SourceFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "content": {
          "maxLength": 200000,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "title": "SourceFile",
      "type": "object"
    },
    "StdioCase": {
      "additionalProperties": false,
      "properties": {
        "caseId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Caseid",
          "type": "string"
        },
        "stdin": {
          "default": "",
          "maxLength": 12000,
          "title": "Stdin",
          "type": "string"
        },
        "expectedOutput": {
          "maxLength": 12000,
          "title": "Expectedoutput",
          "type": "string"
        }
      },
      "required": [
        "caseId",
        "expectedOutput"
      ],
      "title": "StdioCase",
      "type": "object"
    },
    "TestSuite": {
      "additionalProperties": false,
      "properties": {
        "suiteId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Suiteid",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Revision",
          "type": "string"
        },
        "origin": {
          "enum": [
            "GENERATED",
            "PROVIDED",
            "BENCHMARK"
          ],
          "title": "Origin",
          "type": "string"
        },
        "kind": {
          "const": "STDIO",
          "default": "STDIO",
          "title": "Kind",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/StdioCase"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        }
      },
      "required": [
        "suiteId",
        "revision",
        "origin",
        "cases"
      ],
      "title": "TestSuite",
      "type": "object"
    },
    "TestSummary": {
      "additionalProperties": false,
      "properties": {
        "total": {
          "default": 0,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "passed": {
          "default": 0,
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "timedOut": {
          "default": 0,
          "minimum": 0,
          "title": "Timedout",
          "type": "integer"
        }
      },
      "title": "TestSummary",
      "type": "object"
    },
    "WorkflowContext": {
      "additionalProperties": false,
      "properties": {
        "workflowId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Workflowid",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Requestid",
          "type": "string"
        },
        "iteration": {
          "default": 0,
          "minimum": 0,
          "title": "Iteration",
          "type": "integer"
        },
        "producerAgentId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Produceragentid",
          "type": "string"
        },
        "previousReportId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previousreportid"
        }
      },
      "required": [
        "workflowId",
        "requestId",
        "producerAgentId"
      ],
      "title": "WorkflowContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "operation": {
      "enum": [
        "diagnose_error",
        "execute_and_diagnose",
        "check_syntax"
      ],
      "title": "Operation",
      "type": "string"
    },
    "workflow": {
      "$ref": "#/$defs/WorkflowContext"
    },
    "problem": {
      "$ref": "#/$defs/ProblemSpec"
    },
    "code": {
      "$ref": "#/$defs/CodeArtifact"
    },
    "tests": {
      "anyOf": [
        {
          "$ref": "#/$defs/TestSuite"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "feedback": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionFeedback"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schemaVersion",
    "operation",
    "workflow",
    "problem",
    "code"
  ],
  "title": "DiagnosticRequest",
  "type": "object"
}

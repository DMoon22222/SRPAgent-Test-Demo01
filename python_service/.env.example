# 阿里云百炼 / DashScope API Key
# 注意：不要把真实 Key 写入仓库；真实运行时请复制为 .env 并填写。
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# 兼容已有配置命名。如果同时配置 DASHSCOPE_* 与 LLM_*，优先读取 DASHSCOPE_*。
LLM_API_KEY=

# 阿里云百炼 OpenAI-compatible base_url。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=

# 模型名称，根据百炼控制台中开通的模型调整。
DASHSCOPE_MODEL=qwen-plus
LLM_MODEL_ID=

# local 或 docker
SANDBOX_MODE=docker

# 单次编译或运行超时，单位毫秒
SANDBOX_TIMEOUT_MS=5000

# Docker 沙箱镜像，复用当前 Java 项目中的 docker/sandbox/Dockerfile 构建出的镜像
SANDBOX_DOCKER_IMAGE=srp-code-sandbox:latest
SANDBOX_DOCKER_MEMORY=256m
SANDBOX_DOCKER_CPUS=1
SANDBOX_DOCKER_PIDS_LIMIT=64

# stdout / stderr 最大保留字符数，避免 Agent 上下文被超长日志污染
SANDBOX_MAX_OUTPUT_CHARS=12000
